generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personal Information
  firstName      String
  lastName       String
  middleName     String?
  socialSecurity String
  dateOfBirth    String
  phone          String
  alternatePhone String?
  email          String

  // Current Address
  currentAddress  String
  currentCity     String
  currentState    String
  currentZip      String
  currentDuration String
  livedHereThreeYears Boolean @default(false)

  // Driver License Information
  licenseNumber     String
  licenseState      String
  licenseExpiration String
  cdlClass          String?
  endorsements      String?
  restrictions      String?
  licenseImageFront String?
  licenseImageBack  String?

  // Additional Questions
  hasConvictions        Boolean @default(false)
  convictionsDetails    String?
  hasBeenBonded         Boolean @default(false)
  bondedDetails         String?
  canLiftFiftyLbs       Boolean @default(false)
  hasPhysicalLimits     Boolean @default(false)
  physicalLimitsDetails String?
  availableWeekends     Boolean @default(false)
  availableOvernight    Boolean @default(false)
  expectedPay           String?
  howHeardAboutUs       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  referredBy            String?
  signature             String?
  signatureDate         String?

  // Current Employment
  currentEmployer         String
  currentPosition         String
  currentStartDate        String
  currentEndDate          String?
  currentSalary           String
  currentReasonForLeaving String?
  currentSupervisorName   String?
  currentSupervisorPhone  String?
  canContactCurrentEmployer Boolean @default(true)

  // Military Service
  militaryService Boolean @default(false)
  militaryBranch  String?
  militaryRank    String?
  militaryDates   String?
  militaryDuties  String?

  // Application Status
  status String @default("submitted")
  notes  String?

  // Related records
  previousAddresses  Address[]
  previousEmployment Employment[]
  accidents          Accident[]
  violations         Violation[]

  @@map("applications")
}

model Address {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  address  String
  city     String
  state    String
  zip      String
  duration String

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Employment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  employer          String
  position          String
  startDate         String
  endDate           String
  salary            String
  reasonForLeaving  String
  supervisorName    String?
  supervisorPhone   String?
  canContact        Boolean @default(true)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("employment")
}

model Accident {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  date        String
  description String
  fatalities  Boolean @default(false)
  injuries    Boolean @default(false)
  location    String?
  charges     String?

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("accidents")
}

model Violation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  date      String
  violation String
  location  String
  penalty   String?

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("violations")
}
