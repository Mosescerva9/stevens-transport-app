// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personal Information
  firstName    String
  lastName     String
  middleName   String?
  socialSecurity String
  dateOfBirth  String
  phone        String
  email        String

  // Current Address
  currentAddress  String
  currentCity     String
  currentState    String
  currentZip      String
  currentDuration String
  livedHereThreeYears Boolean @default(false)

  // Driver License Information
  licenseNumber     String
  licenseState      String
  licenseExpiration String
  cdlClass          String?
  endorsements      String? // JSON string array
  restrictions      String? // JSON string array

  // Current Employment
  currentEmployer         String
  currentPosition         String
  currentStartDate        String
  currentEndDate          String?
  currentSalary           String
  currentReasonForLeaving String?

  // Military Service
  militaryService Boolean @default(false)
  militaryBranch  String?
  militaryRank    String?
  militaryDates   String?

  // Application Status
  status String @default("submitted") // submitted, under_review, approved, rejected

  // Related records
  previousAddresses Address[]
  previousEmployment Employment[]
  accidents        Accident[]
  violations       Violation[]

  @@map("applications")
}

model Address {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  address  String
  city     String
  state    String
  zip      String
  duration String

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Employment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  employer          String
  position          String
  startDate         String
  endDate           String
  salary            String
  reasonForLeaving  String

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("employment")
}

model Accident {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  date        String
  description String
  fatalities  Boolean @default(false)
  injuries    Boolean @default(false)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("accidents")
}

model Violation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  date      String
  violation String
  location  String

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("violations")
}
